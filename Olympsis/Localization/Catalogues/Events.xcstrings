    "no-venues-contact-sub-title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're always adding new places to play. Know a great spot we're missing? Email us and we'll work on getting it added for you."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre agregamos nuevos lugares para jugar. ¿Conoces un buen lugar que nos falte? Escríbenos y trabajaremos para agregarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ajoutons sans cesse de nouveaux lieux où jouer. Vous connaissez un super endroit qui manque ? Écrivez-nous et nous nous efforcerons de l'ajouter."
          }
        }
      }
    },
