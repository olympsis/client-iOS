    "visibility-group": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Groupe"
          }
        }
      }
    },
    "visibility-group-details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only visible to members of your club or organization. Anyone outside the group won't be able to see or discover this event."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo visible para los miembros de tu club u organización. Cualquier persona fuera del grupo no podrá ver ni descubrir este evento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible uniquement par les membres de votre club ou organisation. Toute personne extérieure au groupe ne pourra pas voir ni découvrir cet événement."
          }
        }
      }
    },
    "visibility-group-tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal for internal club sessions, organization-wide events, or anything meant for your members only."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para sesiones internas del club, eventos de toda la organización o cualquier cosa destinada solo a tus miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour les sessions internes du club, les événements à l'échelle de l'organisation ou tout ce qui est destiné uniquement à vos membres."
          }
        }
      }
    },
    "visibility-private": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé"
          }
        }
      }
    },
    "visibility-private-details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only visible to people you invite or those with a direct link. Won't appear in search or browse results."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo visible para las personas que invites o quienes tengan un enlace directo. No aparecerá en los resultados de búsqueda ni de exploración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible uniquement par les personnes que vous invitez ou celles disposant d'un lien direct. N'apparaîtra pas dans les résultats de recherche ou de navigation."
          }
        }
      }
    },
    "visibility-private-tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal for closed leagues, team-only sessions, or invite-only tournaments."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para ligas cerradas, sesiones solo para equipos o torneos exclusivos por invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour les ligues fermées, les sessions réservées aux équipes ou les tournois sur invitation uniquement."
          }
        }
      }
    },
    "visibility-public": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Público"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Public"
          }
        }
      }
    },
    "visibility-public-details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible to everyone on the platform. Anyone can discover and view this event without an invitation."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible para todos en la plataforma. Cualquiera puede descubrir y ver este evento sin una invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible par tout le monde sur la plateforme. N'importe qui peut découvrir et consulter cet événement sans invitation."
          }
        }
      }
    },
    "visibility-public-tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best for open pick-up games, community tournaments, or events you want maximum turnout for."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para juegos abiertos, torneos comunitarios o eventos en los que quieres la máxima participación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour les matchs improvisés ouverts, les tournois communautaires ou les événements pour lesquels vous souhaitez une participation maximale."
          }
        }
      }
    },
    "visibility-title": {
      "extractionState": "manual",
