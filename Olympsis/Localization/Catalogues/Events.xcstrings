    "event-type-league-desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recurring competitive format where teams play against each other over a set season or series of scheduled matches. Standings are tracked throughout."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un formato competitivo recurrente donde los equipos juegan entre sí durante una temporada establecida o una serie de partidos programados. La clasificación se registra durante todo el proceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un format compétitif récurrent où les équipes s'affrontent au cours d'une saison définie ou d'une série de matchs programmés. Le classement est suivi tout au long."
          }
        }
      }
    },
