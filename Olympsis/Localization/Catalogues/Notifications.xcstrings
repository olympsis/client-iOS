    "event-new-comment": {
      "comment": "Body for the \"New Comment\" push notification. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New comment on your event"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Nouveau commentaire sur votre événement"
          }
        }
      }
    },
