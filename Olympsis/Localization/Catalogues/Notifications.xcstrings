    "event-starting-soon": {
      "comment": "Body for the \"Event Reminder\" push notification. Argument: minutes until start (Int, %lld).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Event starts in %lld min!"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Event starts in %lld mins!"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "machine_translated",
                  "value": "L’événement commence dans %lld min !"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "machine_translated",
                  "value": "L’événement commence dans %lld min !"
                }
              }
            }
          }
        }
      }
    },
