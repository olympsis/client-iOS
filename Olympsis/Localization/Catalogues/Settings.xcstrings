    "delete-account-confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure? Sign in again to confirm."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro? Inicia sesión de nuevo para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr ? Connectez-vous à nouveau pour confirmer."
          }
        }
      }
    },
    "delete-account-warning-body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account means that you will loose all of your info on Olympsis"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar tu cuenta significa que perderás toda tu información en Olympsis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de votre compte signifie que vous perdrez toutes vos informations sur Olympsis"
          }
        }
      }
    },
