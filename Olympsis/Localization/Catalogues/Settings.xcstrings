    "notifications-email-sub-title": {
      "comment": "Notify the user of what we are asking about in terms of notifications through emails",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Olympsis to send you email notifications of special announcements and other important updates"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Olympsis le envíe notificaciones por correo electrónico sobre anuncios especiales y otras actualizaciones importantes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Olympsis à vous envoyer des notifications par e-mail d'annonces spéciales et d'autres mises à jour importantes"
          }
        }
      }
    },
    "notifications-email-title": {
      "extractionState": "manual",
