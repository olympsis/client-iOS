  "strings" : {
    "delete-account-warning-body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account means that you will loose all of your info on Olympsis"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tu cuenta significa que perderás toda tu información en Olympsis"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de votre compte signifie que vous perdrez toutes vos informations sur Olympsis"
          }
        }
      }
    },
    "delete-account-warning-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas seguro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es-tu sûr?"
          }
        }
      }
    },
