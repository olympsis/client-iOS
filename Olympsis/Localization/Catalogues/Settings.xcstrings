    "report-sub-title": {
      "comment": "Tell the user why we want them to report bugs and other issues",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app or a feature is not working as expected, please let us know the details so we can make Olympsis better"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la aplicación o una función no funciona como se esperaba, háganos saber los detalles para que podamos mejorar Olympsis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'application ou une fonctionnalité ne fonctionne pas comme prévu, veuillez nous en informer afin que nous puissions améliorer Olympsis."
