    "help-bug-reports": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug Reports"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Informes de errores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapports de bugs"
          }
        }
      }
    },
    "help-bug-reports-body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you come across a bug or technical issue within the app, you can report it through our dedicated bug report option in the profile settings. Please provide as much detail as possible, including steps to reproduce the issue, screenshots or screen recordings if applicable, and any relevant information about your device and app version. Your detailed reports help us identify and resolve problems more efficiently."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si encuentras un error o problema técnico dentro de la aplicación, puedes reportarlo a través de nuestra opción dedicada de informe de errores en la configuración del perfil. Por favor proporciona la mayor cantidad de detalles posible, incluyendo los pasos para reproducir el problema, capturas de pantalla o grabaciones de pantalla si corresponde, y cualquier información relevante sobre tu dispositivo y versión de la aplicación. Tus informes detallados nos ayudan a identificar y resolver problemas de manera más eficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous rencontrez un bug ou un problème technique dans l'application, vous pouvez le signaler via notre option dédiée de rapport de bugs dans les paramètres du profil. Veuillez fournir autant de détails que possible, y compris les étapes pour reproduire le problème, des captures d'écran ou des enregistrements d'écran le cas échéant, ainsi que toute information pertinente sur votre appareil et la version de l'application. Vos rapports détaillés nous aident à identifier et résoudre les problèmes plus efficacement."
          }
        }
      }
    },
    "help-closing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We value your feedback and strive to address any concerns or issues you may have. Don't hesitate to reach out to us through any of the available channels, and we'll do our best to help you have a seamless and enjoyable experience with Olympsis."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Valoramos tus comentarios y nos esforzamos por abordar cualquier inquietud o problema que puedas tener. No dudes en comunicarte con nosotros a través de cualquiera de los canales disponibles, y haremos todo lo posible para ayudarte a tener una experiencia fluida y agradable con Olympsis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous apprécions vos commentaires et nous nous efforçons de répondre à toutes vos préoccupations ou problèmes. N'hésitez pas à nous contacter via l'un des canaux disponibles, et nous ferons de notre mieux pour vous aider à avoir une expérience fluide et agréable avec Olympsis."
          }
        }
      }
    },
    "help-email": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email Support"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Soporte por correo electrónico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Support par e-mail"
          }
        }
      }
    },
    "help-email-body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For general inquiries, feedback, or if you need to share visual aids like pictures or videos, you can reach out to our support team by emailing contact@olympsis.com. Our dedicated support staff will assist you promptly and professionally."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para consultas generales, comentarios o si necesitas compartir ayudas visuales como fotos o videos, puedes comunicarte con nuestro equipo de soporte enviando un correo electrónico a contact@olympsis.com. Nuestro personal de soporte dedicado te asistirá de manera rápida y profesional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les demandes générales, les commentaires ou si vous avez besoin de partager des aides visuelles comme des photos ou des vidéos, vous pouvez contacter notre équipe de support en envoyant un e-mail à contact@olympsis.com. Notre personnel de support dédié vous assistera rapidement et professionnellement."
          }
        }
      }
    },
    "help-intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At Olympsis, we're committed to providing you with the best possible experience. If you encounter any issues, have questions, or need assistance, we have several channels available to help you."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En Olympsis, estamos comprometidos a brindarte la mejor experiencia posible. Si encuentras algún problema, tienes preguntas o necesitas asistencia, tenemos varios canales disponibles para ayudarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chez Olympsis, nous nous engageons à vous offrir la meilleure expérience possible. Si vous rencontrez des problèmes, avez des questions ou avez besoin d'aide, nous avons plusieurs canaux disponibles pour vous aider."
          }
        }
      }
    },
    "help-social": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social Media"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Redes sociales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseaux sociaux"
          }
        }
      }
    },
    "help-social-body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also connect with us through our social media channels. Follow us on Twitter, Facebook, and Instagram for updates, announcements, and community engagement. Our social media team is actively monitoring these channels and can provide assistance or redirect your inquiries to the appropriate support channels."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes conectarte con nosotros a través de nuestros canales de redes sociales. Síguenos en Twitter, Facebook e Instagram para actualizaciones, anuncios y participación comunitaria. Nuestro equipo de redes sociales monitorea activamente estos canales y puede brindarte asistencia o redirigir tus consultas a los canales de soporte apropiados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également nous contacter via nos réseaux sociaux. Suivez-nous sur Twitter, Facebook et Instagram pour les mises à jour, les annonces et l'engagement communautaire. Notre équipe des réseaux sociaux surveille activement ces canaux et peut vous fournir une assistance ou rediriger vos demandes vers les canaux de support appropriés."
          }
        }
      }
    },
    "help-title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting Help"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener ayuda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenir de l'aide"
          }
        }
      }
    },
    "help-user-reports": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event, Post, or User Reports"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Informes de eventos, publicaciones o usuarios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalements d'événements, de publications ou d'utilisateurs"
          }
        }
      }
    },
    "help-user-reports-body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you encounter any inappropriate events, posts, or malicious user behavior, you can file reports directly within the app. Simply navigate to the right settings menu and follow the prompts to submit your report. Our team will review and take appropriate action to ensure a safe and positive environment for all users."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si encuentras eventos, publicaciones o comportamiento de usuario inapropiados, puedes presentar informes directamente dentro de la aplicación. Simplemente navega al menú de configuración correspondiente y sigue las indicaciones para enviar tu informe. Nuestro equipo revisará y tomará las medidas apropiadas para garantizar un entorno seguro y positivo para todos los usuarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous rencontrez des événements, des publications ou des comportements d'utilisateurs inappropriés, vous pouvez déposer des signalements directement dans l'application. Naviguez simplement vers le menu de paramètres approprié et suivez les instructions pour soumettre votre signalement. Notre équipe examinera et prendra les mesures appropriées pour garantir un environnement sûr et positif pour tous les utilisateurs."
          }
        }
      }
    },
    "logging-out-warning-body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
