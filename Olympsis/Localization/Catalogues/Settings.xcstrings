          }
        }
      }
    },
    "notifications-push-sub-title": {
      "comment": "Notify the user of what we are asking about in terms of notifications through push notifications",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Olympsis to send you push notifications to this device, like event updates and club notifications"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Olympsis le envíe notificaciones push a este dispositivo, como actualizaciones de eventos y notificaciones del club."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser Olympsis à vous envoyer des notifications push sur cet appareil, comme des mises à jour d'événements et des notifications de club"
          }
        }
      }
    },
    "notifications-push-title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push notifications"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones push"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification push"
          }
        }
      }
    },
    "notifications-setting-sub-title": {
      "comment": "Explain to the user why we want to send them notifications",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Olympsis to keep you up to date on what's happening in your community. This includes event updates, club notifications, and more."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Olympsis te mantenga al tanto de lo que ocurre en tu comunidad. Esto incluye actualizaciones de eventos, notificaciones del club y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olympsis vous tient informé(e) de l'actualité de votre communauté : mises à jour d'événements, notifications de club, etc."
          }
        }
      }
    },
