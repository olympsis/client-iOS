    "notifications-email-sub-title" : {
      "comment" : "Notify the user of what we are asking about in terms of notifications through emails",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Olympsis to send you email notifications of special announcements and other important updates"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que Olympsis le envíe notificaciones por correo electrónico sobre anuncios especiales y otras actualizaciones importantes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Olympsis à vous envoyer des notifications par e-mail d'annonces spéciales et d'autres mises à jour importantes"
          }
        }
      }
    },
    "notifications-email-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email notifications"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificaciones por correo electrónico"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications par e-mail"
          }
        }
      }
    },
    "notifications-push-sub-title" : {
      "comment" : "Notify the user of what we are asking about in terms of notifications through push notifications",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Olympsis to send you push notifications to this device, like event updates and club notifications"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que Olympsis le envíe notificaciones push a este dispositivo, como actualizaciones de eventos y notificaciones del club."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser Olympsis à vous envoyer des notifications push sur cet appareil, comme des mises à jour d'événements et des notifications de club"
          }
        }
      }
    },
    "notifications-push-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
