    "auth-user-info-sub-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share a few details to help us tailor Olympsis to your needs."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparta algunos detalles para ayudarnos a adaptar Olympsis a sus necesidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez quelques détails pour nous aider à adapter Olympsis à vos besoins."
          }
        }
      }
    },
    "auth-user-info-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's get to know you better!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Vamos a conocerte mejor!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprenons à mieux vous connaître !"
          }
        }
      }
    },
    "auth-user-sports-sub-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the sports you play or want to learn. We’re adding more soon. Let us know if there’s one you’d like to see!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los deportes que practicas o quieres aprender. Pronto añadiremos más. ¡Cuéntanos si hay alguno que te gustaría ver!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les sports que vous pratiquez ou que vous souhaitez découvrir. Nous en ajouterons bientôt d'autres. N'hésitez pas à nous faire part de vos envies !"
          }
        }
      }
    },
    "auth-user-sports-title" : {
